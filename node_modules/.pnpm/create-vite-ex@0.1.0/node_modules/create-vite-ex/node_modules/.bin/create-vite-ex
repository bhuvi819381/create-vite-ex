else
  export NODE_PATH="/home/blank/Public/script/create-vite-ex/node_modules/.pnpm/create-vite-ex@0.1.0/node_modules/create-vite-ex/node_modules:/home/blank/Public/script/create-vite-ex/node_modules/.pnpm/create-vite-ex@0.1.0/node_modules:/home/blank/Public/script/create-vite-ex/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/bash" ]; then
  exec "$basedir/bash"  "$basedir/../../install.sh" "$@"
else
  exec bash  "$basedir/../../install.sh" "$@"
fi
